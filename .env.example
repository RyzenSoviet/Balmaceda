# ==============================================================================
# Plantilla de configuración local (MySQL / DBeaver)
# Copia este archivo como ".env" en la raíz del proyecto y completa tus datos.
# El archivo ".env" está bloqueado en .gitignore para no filtrar credenciales.
# ==============================================================================

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=balmaceda_db
DB_USER=tu_usuario_mysql
DB_PASS=tu_contrasena_mysql

# Opcional: sobrescribir hash de administrador (generado con password_hash en PHP)
ADMIN_USER=
ADMIN_PASS_HASH=
